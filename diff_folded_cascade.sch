.lib /foss/pdks/ciel/sky130/versions/b344c97eacc2aaf8e14ae7e43e2e9dc0871de2c0/sky130A/libs.tech/ngspice/sky130.lib.spice tt

.control
  option temp = 27
  alter vdd dc = 1.8
  set color0=white
  set color1=black
  set color2=red
  set color3=blue


  op
  echo --- Tail Transistor M1 ---
  print @m.xm1.msky130_fd_pr__pfet_01v8_lvt[id]
  print @m.xm1.msky130_fd_pr__pfet_01v8_lvt[vds]
  print @m.xm1.msky130_fd_pr__pfet_01v8_lvt[vdsat]
  print @m.xm1.msky130_fd_pr__pfet_01v8_lvt[vgs]
  print @m.xm1.msky130_fd_pr__pfet_01v8_lvt[vth]
  print @m.xm1.msky130_fd_pr__pfet_01v8_lvt[gm]
  print @m.xm1.msky130_fd_pr__pfet_01v8_lvt[gds]

  echo --- Differential Pair M2 ---
  print @m.xm2.msky130_fd_pr__pfet_01v8_lvt[id]
  print @m.xm2.msky130_fd_pr__pfet_01v8_lvt[vds]
  print @m.xm2.msky130_fd_pr__pfet_01v8_lvt[vdsat]
  print @m.xm2.msky130_fd_pr__pfet_01v8_lvt[vgs]
  print @m.xm2.msky130_fd_pr__pfet_01v8_lvt[vth]
  print @m.xm2.msky130_fd_pr__pfet_01v8_lvt[gm]
  print @m.xm2.msky130_fd_pr__pfet_01v8_lvt[gds]

  echo --- Differential Pair M3 ---
  print @m.xm3.msky130_fd_pr__pfet_01v8_lvt[id]
  print @m.xm3.msky130_fd_pr__pfet_01v8_lvt[vds]
  print @m.xm3.msky130_fd_pr__pfet_01v8_lvt[vdsat]
  print @m.xm3.msky130_fd_pr__pfet_01v8_lvt[vgs]
  print @m.xm3.msky130_fd_pr__pfet_01v8_lvt[vth]
  print @m.xm3.msky130_fd_pr__pfet_01v8_lvt[gm]
  print @m.xm3.msky130_fd_pr__pfet_01v8_lvt[gds]

  echo --- Top cascade M4 ---
  print @m.xm4.msky130_fd_pr__pfet_01v8_lvt[id]
  print @m.xm4.msky130_fd_pr__pfet_01v8_lvt[vds]
  print @m.xm4.msky130_fd_pr__pfet_01v8_lvt[vdsat]
  print @m.xm4.msky130_fd_pr__pfet_01v8_lvt[vgs]
  print @m.xm4.msky130_fd_pr__pfet_01v8_lvt[vth]
  print @m.xm4.msky130_fd_pr__pfet_01v8_lvt[gm]
  print @m.xm4.msky130_fd_pr__pfet_01v8_lvt[gds]

  echo --- Top cascade M5 ---
  print @m.xm5.msky130_fd_pr__pfet_01v8_lvt[id]
  print @m.xm5.msky130_fd_pr__pfet_01v8_lvt[vds]
  print @m.xm5.msky130_fd_pr__pfet_01v8_lvt[vdsat]
  print @m.xm5.msky130_fd_pr__pfet_01v8_lvt[vgs]
  print @m.xm5.msky130_fd_pr__pfet_01v8_lvt[vth]
  print @m.xm5.msky130_fd_pr__pfet_01v8_lvt[gm]
  print @m.xm5.msky130_fd_pr__pfet_01v8_lvt[gds]

  echo --- Cascode M6 ---
  print @m.xm6.msky130_fd_pr__pfet_01v8_lvt[id]
  print @m.xm6.msky130_fd_pr__pfet_01v8_lvt[vds]
  print @m.xm6.msky130_fd_pr__pfet_01v8_lvt[vdsat]
  print @m.xm6.msky130_fd_pr__pfet_01v8_lvt[vgs]
  print @m.xm6.msky130_fd_pr__pfet_01v8_lvt[vth]
  print @m.xm6.msky130_fd_pr__pfet_01v8_lvt[gm]
  print @m.xm6.msky130_fd_pr__pfet_01v8_lvt[gds]

  echo --- Cascode M7 ---
  print @m.xm7.msky130_fd_pr__pfet_01v8_lvt[id]
  print @m.xm7.msky130_fd_pr__pfet_01v8_lvt[vds]
  print @m.xm7.msky130_fd_pr__pfet_01v8_lvt[vdsat]
  print @m.xm7.msky130_fd_pr__pfet_01v8_lvt[vgs]
  print @m.xm7.msky130_fd_pr__pfet_01v8_lvt[vth]
  print @m.xm7.msky130_fd_pr__pfet_01v8_lvt[gm]
  print @m.xm7.msky130_fd_pr__pfet_01v8_lvt[gds]

  echo --- Bottom cascade M8 ---
  print @m.xm8.msky130_fd_pr__nfet_01v8[id]
  print @m.xm8.msky130_fd_pr__nfet_01v8[vds]
  print @m.xm8.msky130_fd_pr__nfet_01v8[vdsat]
  print @m.xm8.msky130_fd_pr__nfet_01v8[vgs]
  print @m.xm8.msky130_fd_pr__nfet_01v8[vth]
  print @m.xm8.msky130_fd_pr__nfet_01v8[gm]
  print @m.xm8.msky130_fd_pr__nfet_01v8[gds]

  echo --- Bottom cascade M9 ---
  print @m.xm9.msky130_fd_pr__nfet_01v8[id]
  print @m.xm9.msky130_fd_pr__nfet_01v8[vds]
  print @m.xm9.msky130_fd_pr__nfet_01v8[vdsat]
  print @m.xm9.msky130_fd_pr__nfet_01v8[vgs]
  print @m.xm9.msky130_fd_pr__nfet_01v8[vth]
  print @m.xm9.msky130_fd_pr__nfet_01v8[gm]
  print @m.xm9.msky130_fd_pr__nfet_01v8[gds]

  echo --- Cascade M10 ---
  print @m.xm10.msky130_fd_pr__nfet_01v8[id]
  print @m.xm10.msky130_fd_pr__nfet_01v8[vds]
  print @m.xm10.msky130_fd_pr__nfet_01v8[vdsat]
  print @m.xm10.msky130_fd_pr__nfet_01v8[vgs]
  print @m.xm10.msky130_fd_pr__nfet_01v8[vth]
  print @m.xm10.msky130_fd_pr__nfet_01v8[gm]
  print @m.xm10.msky130_fd_pr__nfet_01v8[gds]

  echo --- Cascade M11 ---
  print @m.xm11.msky130_fd_pr__nfet_01v8[id]
  print @m.xm11.msky130_fd_pr__nfet_01v8[vds]
  print @m.xm11.msky130_fd_pr__nfet_01v8[vdsat]
  print @m.xm11.msky130_fd_pr__nfet_01v8[vgs]
  print @m.xm11.msky130_fd_pr__nfet_01v8[vth]
  print @m.xm11.msky130_fd_pr__nfet_01v8[gm]
  print @m.xm11.msky130_fd_pr__nfet_01v8[gds]


* ---------- Power dissipation (DC operating point) ----------

  let i_vdd = -i(vdd)
  let p_diss = 1.8 * i_vdd

  echo --- * Supply current and Power dissipation * ---
  print i_vdd p_diss


* ---------- Differential gain: vin1 = +0.5, vin2 = -0.5 (Vid = 1 V) ----------
  ac dec 20 1 10g

* ---------- Common-mode gain: vin1 = vin2 = 1 V AC (Vic = 1 V) ----------
  alter vin1 acmag = 1
  alter vin2 acmag = 1
  ac dec 20 1 10g

* ---------- Gains and CMRR ----------
  let Ad      = ac1.vout1 - ac1.vout2
  let Acm     = (ac2.vout1 + ac2.vout2)/2
  let Ad_dB   = db(Ad)
  let Acm_dB  = db(Acm)
  let CMRR_dB = Ad_dB - Acm_dB

  echo --- Gains at 1 Hz (dB) ---
  print Ad_dB[0] Acm_dB[0] CMRR_dB[0]

  plot Ad_dB Acm_dB CMRR_dB xlog title 'Ad, Acm and CMRR (dB)'


* ---------- Transient ----------

  tran 1u 5m
  plot v(vin1) v(vin2) title 'Input: differential sine (1 kHz)' 
  plot v(vout1) v(vout2) title 'Output'
 

* ---------- DC transfer ----------
  dc vin2 0 1.8 0.01
  plot vout1 vout2 title 'DC transfer Characteristic'


 write diff_folded_cascade.raw

.endc
"}
